<?xml version="1.0" encoding="UTF-8"?>
<!--
  RTI Connext Professional 7.3.1 — Monitoring Library 2.0 Configuration
  ==========================================================================
  File:    qos/FactoryQos.xml
  Purpose: Main configuration file for Connext applications to configure
           the participant factory QoS. This file is intended to be loaded alongside
           your application QoS XML files.

  QoS Profiles
  ========

  Factory::Main
      This profile is intended to be used as the default participant factory
      profile for the application. All participant factory QoS intended to be
      applied to for the process should be derived from this profile.

  Usage
  =====
  Load this file alongside files that configure independent behavior 
  (e.g. monitoring, logging, entity enabling, etc.) to ensure a single entry
  point for all participant factory QoS configuration.

    > NDDS_QOS_PROFILES="qos/Monitoring.xml;qos/Logging.xml;qos/FactoryQos.xml"

-->
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/7.3.1/rti_dds_profiles.xsd">    
    
    <qos_library name="Factory">

        <!-- ==================================================================
             Main
             ──────────────────────────────────────────────────────────────────
             This profile is intended to be used as the default participant factory
             profile for the application. All participant factory QoS intended to be
             applied to for the process should be derived from this profile.

             It is best to inherit from base profiles configuring independent
             behavior (e.g. monitoring, logging, entity enabling, etc.) to ensure a
             single entry point for all participant factory QoS configuration.
        ================================================================== -->
        <qos_profile name="Main" is_default_participant_factory_profile="true">
            <participant_factory_qos>
                <base_name>
                    <element>Monitoring::Main</element>
                    <element>Logging::Main</element>
                </base_name>
            </participant_factory_qos>
        </qos_profile>

    </qos_library>
</dds>